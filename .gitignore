__pycache__/
.mypy_cache/
venv/
main_plot.tex
main_table.tex
hnsw/data/1m/
hnsw/data/laion1m_base.fvecs
hnsw/data/100k/
hnsw/logs/
local-tests/
hnsw/data
hnsw/paper*
hnsw/o_hnsw_backup.py
hnsw/sweep
hnsw/cluster/plaintext/log
